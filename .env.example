# Placeholders only. Real values live in your secret manager / Supabase function secrets, never in Git.
# --- Supabase Edge Function secrets (supabase secrets set --env-file ...) ---
PAYMENT_PROVIDER=sandbox                  # sandbox | stripe
SANDBOX_WEBHOOK_SECRET=change-me          # sandbox only
SANDBOX_SIMULATION_ENABLED=false          # dev only: lets sandbox-pay simulate payments. NEVER true in production
STRIPE_SECRET_KEY=sk_test_...             # use TEST keys until launch approval
STRIPE_WEBHOOK_SECRET=whsec_...
ALLOW_LIVE_PAYMENTS=false                 # must stay false until docs/DEPLOYMENT.md launch checklist is signed off
CRON_SECRET=long-random-string            # authenticates maintenance/send-push/process-refunds callers
ADMIN_ALLOWED_ORIGINS=https://admin.example.com
FCM_SERVICE_ACCOUNT_JSON=                 # optional: Firebase service account JSON for push
